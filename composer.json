{
    "name": "kenangundogan/htmlmin",
    "description": "HTMLMin Is A Simple HTML Minifier For Laravel",
    "keywords": ["laravel", "framework", "html minifier", "html", "minifier", "HTMLMin", "Laravel HTMLMin", "Laravel-HTMLMin"],
    "license": "MIT",
    "authors": [
        {
            "name": "Kenan Gündoğan"
        }
    ],
    "require": {
        "php": ">=7.3",
        "illuminate/contracts": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "mrclay/minify": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "HTMLMin\\HTMLMin\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist"
    },
    "extra": {
        "laravel": {
            "providers": [
                "HTMLMin\\HTMLMin\\HTMLMinServiceProvider"
            ],
            "aliases": {
                "HTMLMin": "HTMLMin\\HTMLMin\\Facades\\HTMLMin"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
